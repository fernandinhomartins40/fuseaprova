# =============================================================================
# Fuse Aprova: .env de PRODUÇÃO (modelo)
#
# O deploy.sh copia este arquivo para /root/fuseaprova/deploy/.env no PRIMEIRO
# deploy e gera sozinho os valores marcados [gerado]. Depois disso ele nunca
# sobrescreve um valor que já esteja preenchido.
#
# [dono] = o dono precisa preencher na VPS:
#   nano /root/fuseaprova/deploy/.env
#   cd /root/fuseaprova/deploy && docker compose up -d --force-recreate api worker
#
# ATENÇÃO com "$": o Docker Compose interpreta $VAR dentro do .env. A chave
# do Asaas começa com "$" ($aact_...), então ela vai entre ASPAS SIMPLES:
#   ASAAS_API_KEY='$aact_prod_000...'
# =============================================================================

# --- Geral --------------------------------------------------------------------
NODE_ENV=production
TZ=America/Sao_Paulo
APP_URL=https://www.fuseaprova.com.br
LOG_LEVEL=info

# --- Banco (container postgres; o host é o nome do serviço) -------------------
POSTGRES_USER=fuse
POSTGRES_DB=fuse
# [gerado] senha hex (não precisa de escape na URL)
POSTGRES_PASSWORD=
# [gerado] montada a partir da senha acima
DATABASE_URL=

# --- API ----------------------------------------------------------------------
# [gerado] openssl rand -hex 32
SESSION_SECRET=
COOKIE_DOMAIN=
COOKIE_SECURE=1
SUPORTE_WHATSAPP=
SUPORTE_EMAIL=

# --- Pagamento (Asaas) --------------------------------------------------------
# [dono] chave da API do Asaas, ENTRE ASPAS SIMPLES (começa com $)
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3   Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# [gerado] o mesmo valor vai no painel do Asaas (webhook, "Token de autenticação")
ASAAS_WEBHOOK_TOKEN=
PRICE_CENTS=39700
# Preço de cada concurso adicional do mesmo aluno (R$ 197,00; D21).
PRICE_ADICIONAL_CENTS=19700

# --- E-mail (SMTP do próprio dono) ----------------------------------------------
# [dono]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fuse Aprova <nao-responda@fuseaprova.com.br>"

# --- Web Push (VAPID) -----------------------------------------------------------
# [gerado] par de chaves próprio (web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@fuseaprova.com.br

# --- Arquivos e backup ------------------------------------------------------------
# Caminhos DENTRO dos containers. No host eles são /root/fuseaprova/arquivos e
# /root/fuseaprova/backups (montados pelo docker-compose.yml).
ARQUIVOS_DIR=/srv/fuse/arquivos
BACKUP_DIR=/srv/fuse/backups

# --- Coletor ----------------------------------------------------------------------
CRAWLER_USER_AGENT="FuseAprovaBot/1.0 (+https://www.fuseaprova.com.br)"
CRAWLER_INTERVALO_MS=2000
PDFTOTEXT_BIN=pdftotext

# --- Imagens em produção (o deploy.sh mantém; não edite à mão) --------------------
FUSEAPROVA_API_IMAGE=
FUSEAPROVA_WEB_IMAGE=
FUSEAPROVA_WORKER_IMAGE=
