<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: abertura do sistema com o fundo creme e o ícone da marca (Splash Screen API). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fuse_creme</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icone</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
