{
  "name": "@fuse/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "App nativo (Android e iOS) do painel do aluno: Capacitor sobre o build 'app' do @fuse/web.",
  "scripts": {
    "web": "pnpm --filter @fuse/web build:app",
    "sync": "pnpm run web && cap sync",
    "sync:android": "pnpm run web && cap sync android",
    "sync:ios": "pnpm run web && cap sync ios",
    "assets": "node scripts/gerar-assets.mjs",
    "android:abrir": "cap open android",
    "ios:abrir": "cap open ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "sharp": "~0.34.5"
  }
}
