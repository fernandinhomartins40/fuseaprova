{
  "name": "@fuse/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/gerar-assets.mjs",
    "capturas": "node scripts/capturar-telas.mjs",
    "tamanho": "node scripts/medir-bundle.mjs",
    "build:app": "tsc --noEmit && vite build --mode app",
    "capturas:loja": "node scripts/capturar-loja.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fuse/shared": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "idb": "^8.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "zod": "3.25.76"
