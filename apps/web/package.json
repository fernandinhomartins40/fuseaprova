    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "sharp": "~0.34.5",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.4",
    "workbox-window": "^7.4.1"
