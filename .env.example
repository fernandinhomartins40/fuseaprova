# =============================================================================
# Fuse Aprova — variáveis de ambiente
# Copie para .env (que NUNCA vai para o git) e preencha. Valores aqui são exemplos.
# =============================================================================

# --- Geral --------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Fuso de todas as regras de "dia" e "semana" (o código também fixa America/Sao_Paulo).
TZ=America/Sao_Paulo
# URL pública da PWA (usada em e-mails, links de redefinição de senha e CORS).
APP_URL=https://app.seudominio.com.br
# Nível de log da API e do worker: fatal | error | warn | info | debug
LOG_LEVEL=info

# --- Banco de dados -----------------------------------------------------------
# Produção (Docker Compose): PostgreSQL 16.
DATABASE_URL=postgres://fuse:troque-esta-senha@postgres:5432/fuse
# Dev sem Docker: PGlite (Postgres em WebAssembly) numa pasta local, ou em memória:
# DATABASE_URL=pglite://./.pglite
# DATABASE_URL=pglite://memoria
# Credenciais do contêiner postgres (usadas pelo deploy/docker-compose.yml).
POSTGRES_USER=fuse
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fuse

# Seed de DESENVOLVIMENTO: 1 publica as questões autorais de exemplo (que entram
# como `rascunho`) para o app mostrá-las. Nunca use em produção (o seed recusa).
SEED_DEV_PUBLICAR=0

# --- API ----------------------------------------------------------------------
# Porta e host do Fastify (o nginx do container faz o proxy de /api para cá).
API_PORT=3000
API_HOST=0.0.0.0
# Segredo para assinar cookies (gere com: openssl rand -hex 32).
SESSION_SECRET=
# Domínio do cookie de sessão (vazio = o host atual).
COOKIE_DOMAIN=
# Cookie só em HTTPS (1). Use 0 apenas em dev via http fora de localhost.
COOKIE_SECURE=1
# Opcional: dados do 1º admin para `pnpm --filter @fuse/api cli admin:criar` sem prompt.
ADMIN_EMAIL=
ADMIN_NOME=
ADMIN_SENHA=
# Contato de suporte mostrado em Configurações (WhatsApp com DDI+DDD e/ou e-mail).
SUPORTE_WHATSAPP=5542999999999
SUPORTE_EMAIL=suporte@seudominio.com.br

# --- Pagamento (Asaas, único serviço externo) -------------------------------------
# Chave da API (sandbox em teste; produção no ar). Vai no header access_token.
# No .env do Docker Compose ela vai ENTRE ASPAS SIMPLES, porque começa com $
# e o Compose interpretaria $aact... como variável: ASAAS_API_KEY='$aact_...'
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3   Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que o Asaas envia no header asaas-access-token do webhook (defina no painel do Asaas).
ASAAS_WEBHOOK_TOKEN=
# Preço em centavos do 1º concurso do aluno (R$ 397,00).
PRICE_CENTS=39700
# Preço de cada concurso ADICIONAL do mesmo aluno, com desconto (R$ 197,00). Cada concurso é uma
# compra (D21). O valor da cobrança sai daqui: não há nada a mudar no painel do Asaas.
PRICE_ADICIONAL_CENTS=19700

# --- E-mail (SMTP do próprio dono) -------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fuse Aprova <nao-responda@seudominio.com.br>"

# --- Web Push (chaves VAPID próprias; gere com: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# --- Arquivos e backup ----------------------------------------------------------
# PDFs do coletor (fora do diretório público) e uploads do admin.
ARQUIVOS_DIR=/srv/fuse/arquivos
# Destino do pg_dump diário (14 diários e 8 semanais).
BACKUP_DIR=/srv/fuse/backups

# --- Coletor (packages/crawler) ------------------------------------------------------
# User-Agent identificado (PRD 7.5) e intervalo mínimo entre requisições ao mesmo host.
CRAWLER_USER_AGENT="FuseAprovaBot/1.0 (+https://app.seudominio.com.br/robo)"
CRAWLER_INTERVALO_MS=2000
# Binário do pdftotext (poppler-utils), usado pelo importador de PDF. Já vem na imagem do worker.
PDFTOTEXT_BIN=pdftotext

# --- Produção na VPS (deploy/deploy.sh) ----------------------------------------------
# O .env de produção é criado pelo deploy.sh a partir de deploy/env.modelo, com os
# segredos gerados na VPS. Ele também guarda as imagens em uso, por digest:
# FUSEAPROVA_API_IMAGE=ghcr.io/fernandinhomartins40/fuseaprova-api@sha256:...
# FUSEAPROVA_WEB_IMAGE=ghcr.io/fernandinhomartins40/fuseaprova-web@sha256:...
# FUSEAPROVA_WORKER_IMAGE=ghcr.io/fernandinhomartins40/fuseaprova-worker@sha256:...
# Porta local (só 127.0.0.1) do nginx do projeto; o nginx do host faz proxy para ela.
# FUSEAPROVA_PORTA=3600

# --- Web (build) ---------------------------------------------------------------------
# No GitHub Actions vêm das *variáveis* (não secrets) do repositório com o mesmo nome.
# Contato de suporte embutido no bundle (Configurações → Suporte).
VITE_SUPORTE_WHATSAPP=5542999999999
VITE_SUPORTE_EMAIL=suporte@seudominio.com.br
